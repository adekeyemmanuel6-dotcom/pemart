# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paystack. Use TEST keys until launch ----
# Also set the webhook URL in the Paystack dashboard to https://YOUR-DOMAIN/api/webhooks/paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---- Resend ----
RESEND_API_KEY=
EMAIL_FROM="Wear The Word <orders@yourdomain.com>"
ADMIN_NOTIFY_EMAIL=

# ---- Cron: Vercel sends this as a Bearer token to /api/cron/* (expires unpaid orders hourly) ----
CRON_SECRET=

# ---- Cookie banner: OFF by default. Set to 1 to show it (then analytics below load only after consent). With it off, no analytics run ----
# NEXT_PUBLIC_COOKIE_BANNER=1

# ---- Analytics. Each is optional and only loads after the visitor accepts cookies ----
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- LOCAL DEVELOPMENT ONLY (all ignored or refused when NODE_ENV=production) ----
# Run the whole checkout against a plain local Postgres instead of Supabase:
#   npm run db:local && npm run db:fixture   (then: rm -rf .next)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pemart_local
# (npm run test:e2e uses its own database, pemart_e2e, and sets these itself)
# Simulated Paystack popup + verification so you can test the flow with no Paystack account:
# PAYSTACK_MOCK=1
# Read the catalogue from a specific fixture file (used by the integration tests):
# PEMART_FIXTURE_PATH=

# Optional Google Search Console verification token (not a secret).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
